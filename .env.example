# Copy to .env and fill in for local dev. All values have safe defaults
# except AWS credentials, which come from your normal AWS credential chain
# (env vars / ~/.aws/credentials / instance role) -- not set here.

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_TIMEOUT_S=30
BEDROCK_MAX_RETRIES=2

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

SERVICE_NAME=gateway-api
LOG_LEVEL=INFO
MAX_INPUT_CHARS=32000

# M1 identity. Leave OIDC_JWKS_URL empty to use a local dev keypair
# (auto-generated at .dev/jwt_keypair.json) instead of a real IdP --
# see scripts/generate_dev_token.py.
OIDC_ISSUER=https://dev-issuer.local/
OIDC_AUDIENCE=bedrock-gateway
OIDC_JWKS_URL=
OIDC_JWKS_CACHE_TTL_S=300
DEV_JWT_KEYPAIR_PATH=.dev/jwt_keypair.json
CHAT_REQUIRED_ROLE=developer
ADMIN_REQUIRED_ROLE=platform_admin

# M4 gateway reliability
ROUTE_SET_CONFIG_PATH=policies/route_sets.yaml
RESPONSE_CACHE_TTL_S=60
RESPONSE_CACHE_MAX_ENTRIES=1000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_S=30
